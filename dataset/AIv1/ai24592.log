        "id": "ci_058a75147006271d006989e0c4c28881a2baf3d80eba499614",
        "code": "ratio = 0.765\ndef net(gross, non_tax=0):\n    return gross*ratio + non_tax\n\nfor perf_pct in [0.05, 0.10, 0.15]:\n    for risk in [2000, 6000, 8000]:\n        gross = 72590 + perf_pct*72590 + risk # service tariff + performance + special risk; ignore responsibility & stabilization for now\n        net_val = net(gross, non_tax=6000) # add housing 6000\n        print(f\"perf {perf_pct*100:.0f}%, risk {risk}: gross={gross:.0f}, net≈{net_val:.0f}\")",
        "container_id": "cntr_6989df96cefc81919a534958e91e185f0cf4e993cee694e7",
